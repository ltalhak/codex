<Window x:Class="SolarOrderQuiz.Views.QuestionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:SolarOrderQuiz.Converters"
        xmlns:resources="clr-namespace:SolarOrderQuiz.Resources"
        Title="{Binding Title}"
        WindowStartupLocation="CenterOwner"
        SizeToContent="WidthAndHeight"
        ResizeMode="NoResize"
        Background="#1B263B"
        Foreground="White"
        MinWidth="380">
    <Window.Resources>
        <converters:BooleanToVisibilityConverter x:Key="FeedbackVisibilityConverter" CollapseWhenFalse="True" />
    </Window.Resources>
    <Border Padding="16" Margin="8">
        <StackPanel>
            <TextBlock Text="{Binding QuestionText}" TextWrapping="Wrap" FontSize="16" FontWeight="Bold" Margin="0,0,0,12" />
            <ListBox ItemsSource="{Binding Choices}"
                     SelectedItem="{Binding SelectedChoice, Mode=TwoWay}"
                     Margin="0,0,0,12"
                     BorderThickness="0">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <RadioButton GroupName="Options"
                                     Content="{Binding Text}"
                                     Tag="{Binding Key}"
                                     FontSize="14"
                                     Padding="4"
                                     HorizontalContentAlignment="Left"
                                     IsChecked="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}, Mode=TwoWay}"/>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="{x:Static resources:Strings.Confirm}" Command="{Binding ConfirmCommand}" />
                <Button Content="{x:Static resources:Strings.Continue}" Command="{Binding ContinueCommand}" Margin="8,0,0,0" />
            </StackPanel>
            <StackPanel Margin="0,12,0,0" Visibility="{Binding ShowFeedback, Converter={StaticResource FeedbackVisibilityConverter}}">
                <TextBlock Text="{Binding FeedbackMessage}" FontWeight="SemiBold" />
                <TextBlock Text="{Binding Explanation}" TextWrapping="Wrap" Margin="0,6,0,0" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
